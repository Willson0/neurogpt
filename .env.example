# ---- NeuroGPT: server configuration (copy to .env and fill in) ----

# Public HTTPS address of the app (Telegram requires HTTPS)
APP_URL=https://app.example.com
# docker compose run --rm --entrypoint php app artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false
WEB_PORT=80

# ---- Database: the Telegram bot's MySQL (models.py) ----
# The app works on the bot tables (users, models, prompts, shop, payments, query_logs) without changing them
# and adds its own tables wa_*. Remote database: set DB_HOST/DB_PORT and remove COMPOSE_PROFILES below.
# A MySQL on this same server outside Docker: DB_HOST=host.docker.internal
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=neurogpt
DB_USERNAME=neurogpt
DB_PASSWORD=change-me
# TLS to a remote MySQL (path inside the container to the CA certificate), optional
MYSQL_ATTR_SSL_CA=
# Leave empty: the app tables then get the same collation as the bot tables.
DB_COLLATION=
# Local MySQL container (empty DB_HOST). Delete this line when DB_HOST points to the remote bot database.
COMPOSE_PROFILES=local-db
DB_ROOT_PASSWORD=change-me-too

# ---- How the bot keeps its data (see README, "База данных бота") ----
# start_sub_time / end_sub_time / temp_tokens_until: s = Unix seconds, ms = milliseconds
BOT_TIME_UNIT=s
# Models a new user gets (users.text_model / photo_model / video_model are required). Empty = first model of the type.
BOT_DEFAULT_TEXT_MODEL_ID=
BOT_DEFAULT_PHOTO_MODEL_ID=
BOT_DEFAULT_VIDEO_MODEL_ID=
# Paid purchases also go to the bot table payments (was_bought=1, is_proceed=1) and users.paid_money
BOT_MIRROR_PAYMENTS=true
# Generations and chat answers also go to query_logs
BOT_QUERY_LOGS=true
# How a purchase is found in the bot table shop (category / item / amount)
BOT_SHOP_TOKENS_CATEGORY=tokens
BOT_SHOP_TOKENS_ITEM=tokens
BOT_SHOP_SUB_CATEGORY=sub
BOT_SHOP_SUB_AMOUNT=days

# ---- The old web app database, only for the one-time move: php artisan neurogpt:import-legacy ----
# With the local container (profile local-db) that is: LEGACY_DB_HOST=db and the old DB_* values.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=neurogpt
LEGACY_DB_USERNAME=neurogpt
LEGACY_DB_PASSWORD=

# Fill the catalog (models, photosets, news) on every start. Safe to repeat.
SEED_ON_START=true

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://app.example.com
# Short name of the Mini App from BotFather (/newapp), for t.me/<bot>/<short_name>?startapp=... links. Empty = Main App links.
TELEGRAM_WEBAPP_SHORT_NAME=
TELEGRAM_INIT_DATA_TTL=86400
# How long an admin's browser sign-in (Telegram Login Widget) stays valid, in seconds.
TELEGRAM_LOGIN_TTL=2592000
TELEGRAM_ALLOW_DEV_AUTH=false

# Telegram Stars: payments inside Telegram, no extra accounts needed.
# Price in stars = price in rubles / TELEGRAM_STARS_RUB_RATE (how many rubles one star is worth to you).
TELEGRAM_STARS_ENABLED=true
TELEGRAM_STARS_RUB_RATE=2.0
# Link shown as "Support" in the profile and in /paysupport (for example https://t.me/your_support)
SUPPORT_URL=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://app.example.com
YOOKASSA_VERIFY_IP=true
YOOKASSA_RECEIPT=false
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_TAX_SYSTEM=1
YOOKASSA_VAT_CODE=1

# Generation providers: fake | openai | replicate
GENERATION_DRIVER=openai
# HydraAI (OpenAI-compatible). For OpenAI itself: https://api.openai.com/v1 and OPENAI_IMAGE_EDIT=multipart
OPENAI_BASE_URL=https://api.hydraai.ru/v1
OPENAI_API_KEY=
OPENAI_IMAGE_EDIT=image_url
OPENAI_IMAGE_SIZE=ratio
OPENAI_TEXT_MODEL=o4-mini
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
# Legacy Replicate song endpoint.
REPLICATE_SONG_MODEL=
REPLICATE_SONG_PROMPT_FIELD=prompt
REPLICATE_SONG_DURATION_FIELD=duration

# kie.ai: Suno V6, Seedream covers, video and image tools.
# Get the key at https://kie.ai/api-key.
KIE_API_KEY=
# Russian prompts are translated to English before they go to the video model (uses OPENAI_API_KEY)
KIE_TRANSLATE_PROMPT=true

# Music studio. Enable with a Kie.ai key and refresh the model catalog.
FEATURE_SONGS=false
MUSIC_LYRICS_TOKENS=5
MUSIC_COVER_TOKENS=15
MUSIC_PERSONA_TOKENS=5
MUSIC_STYLE_TOKENS=5
MUSIC_WAV_TOKENS=5
MUSIC_STEMS_TOKENS=30

# Limits per user
LIMIT_ACTIVE_GENERATIONS=6
LIMIT_REFERRAL_REWARDS=100
LIMIT_IMPROVE_PER_DAY=30
# Origins allowed to call the API from a browser (comma separated). Empty = APP_URL only.
CORS_ALLOWED_ORIGINS=
