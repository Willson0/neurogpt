# ---- NeuroGPT: server configuration (copy to .env and fill in) ----

# Public HTTPS address of the app (Telegram requires HTTPS)
APP_URL=https://app.example.com
# docker compose run --rm --entrypoint php app artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false
WEB_PORT=80

# Database
DB_DATABASE=neurogpt
DB_USERNAME=neurogpt
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Fill the catalog (models, photosets, news) on every start. Safe to repeat.
SEED_ON_START=true

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://app.example.com
TELEGRAM_INIT_DATA_TTL=86400
TELEGRAM_ALLOW_DEV_AUTH=false

# Telegram Stars: payments inside Telegram, no extra accounts needed.
# Price in stars = price in rubles / TELEGRAM_STARS_RUB_RATE (how many rubles one star is worth to you).
TELEGRAM_STARS_ENABLED=true
TELEGRAM_STARS_RUB_RATE=2.0
# Link shown as "Support" in the profile and in /paysupport (for example https://t.me/your_support)
SUPPORT_URL=

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://app.example.com
YOOKASSA_VERIFY_IP=true
YOOKASSA_RECEIPT=false
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_TAX_SYSTEM=1
YOOKASSA_VAT_CODE=1

# Generation providers: fake | openai | replicate
GENERATION_DRIVER=openai
# HydraAI (OpenAI-compatible). For OpenAI itself: https://api.openai.com/v1 and OPENAI_IMAGE_EDIT=multipart
OPENAI_BASE_URL=https://api.hydraai.ru/v1
OPENAI_API_KEY=
OPENAI_IMAGE_EDIT=image_url
OPENAI_IMAGE_SIZE=ratio
OPENAI_TEXT_MODEL=o4-mini
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
# Songs: Replicate model version id of a music model (used only when FEATURE_SONGS=true).
REPLICATE_SONG_MODEL=
REPLICATE_SONG_PROMPT_FIELD=prompt
REPLICATE_SONG_DURATION_FIELD=duration

# kie.ai: video (Veo 3.1, Kling 3.0, Seedance 2) and the tools "upscale", "remove background", "animate".
# Get the key at https://kie.ai/api-key. Without it video models are switched off.
KIE_API_KEY=
# Russian prompts are translated to English before they go to the video model (uses OPENAI_API_KEY)
KIE_TRANSLATE_PROMPT=true

# Songs are hidden behind "Coming soon" until this is true (and REPLICATE_SONG_MODEL is set)
FEATURE_SONGS=false

# Limits per user
LIMIT_ACTIVE_GENERATIONS=6
LIMIT_REFERRAL_REWARDS=100
LIMIT_IMPROVE_PER_DAY=30
# Origins allowed to call the API from a browser (comma separated). Empty = APP_URL only.
CORS_ALLOWED_ORIGINS=
