# ---- NeuroGPT: server configuration (copy to .env and fill in) ----

# Public HTTPS address of the app (Telegram requires HTTPS)
APP_URL=https://app.example.com
# docker compose run --rm --entrypoint php app artisan key:generate --show
APP_KEY=
APP_ENV=production
APP_DEBUG=false
WEB_PORT=80

# Database
DB_DATABASE=neurogpt
DB_USERNAME=neurogpt
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Fill the catalog (models, photosets, news) on every start. Safe to repeat.
SEED_ON_START=true

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://app.example.com
TELEGRAM_INIT_DATA_TTL=86400
TELEGRAM_ALLOW_DEV_AUTH=false

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://app.example.com
YOOKASSA_VERIFY_IP=true
YOOKASSA_RECEIPT=false
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_TAX_SYSTEM=1
YOOKASSA_VAT_CODE=1

# Generation providers: fake | openai | replicate
GENERATION_DRIVER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
