APP_NAME=NeuroGPT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# DB_DATABASE=neurogpt
# DB_USERNAME=neurogpt
# DB_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=http://localhost:5173
TELEGRAM_INIT_DATA_TTL=86400
# Local only: lets the app run in a plain browser with "Authorization: tma dev:<id>"
TELEGRAM_ALLOW_DEV_AUTH=false

# --- YooKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Where the user lands after paying (your Mini App link or site)
YOOKASSA_RETURN_URL=http://localhost:5173
YOOKASSA_VERIFY_IP=true
YOOKASSA_RECEIPT=false
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_TAX_SYSTEM=1
YOOKASSA_VAT_CODE=1

# --- Generation ---
# fake | openai | replicate (used by the seeder for new model rows)
GENERATION_DRIVER=fake
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
